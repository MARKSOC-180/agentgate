{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentgate.dev/schema/anchor-record.schema.json",
  "title": "MCP-SP Anchor Record",
  "description": "External anchor of an audit chain head (MCP-SP SPEC §3.1).",
  "type": "object",
  "required": ["ts", "count", "audit_head", "prev_anchor", "anchor_hash"],
  "properties": {
    "ts": { "type": "number" },
    "count": { "type": "integer", "minimum": 0 },
    "audit_head": { "type": "string" },
    "prev_anchor": { "type": "string" },
    "anchor_hash": { "type": "string" }
  },
  "additionalProperties": true
}
